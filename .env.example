# Supabase (public - safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_AUTH_MODE=supabase

# Supabase (secret - backend only, NEVER expose in frontend)
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
API_KEY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Runtime mode
SEARCHTUBE_STORAGE=supabase
SEARCHTUBE_AUTH_MODE=supabase
SEARCHTUBE_API_KEY_MODE=hybrid
SEARCHTUBE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Hosted free-tier caps
FREE_SEARCHES_PER_MONTH=100
FREE_INDEXED_VIDEOS_TOTAL=15
FREE_INDEXED_TRANSCRIPT_SECONDS_TOTAL=18000
FREE_MAX_IMPORT_VIDEOS=10
FREE_MAX_SEARCH_RESULTS=5
FREE_MAX_ACTIVE_INGESTION_JOBS=1

# Stripe billing (backend only)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLUS_MONTHLY_LOOKUP_KEY=memexai_plus_monthly_v1
STRIPE_PLUS_ANNUAL_LOOKUP_KEY=memexai_plus_annual_v1
STRIPE_PRO_MONTHLY_LOOKUP_KEY=memexai_pro_monthly_v1
STRIPE_PRO_ANNUAL_LOOKUP_KEY=memexai_pro_annual_v1
STRIPE_SUCCESS_URL=http://localhost:5173/?billing=success
STRIPE_CANCEL_URL=http://localhost:5173/?billing=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/?settings=billing
# Promotional trial signup codes: code:plan:days (comma-separated, plan is plus|pro)
PROMO_TRIAL_CODES=producthunt:plus:14

# Gemini API (server-side free tier key)
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini-3.1-flash-lite

# Backend URL for frontend (optional, defaults to localhost:8080)
VITE_API_URL=http://localhost:8080
