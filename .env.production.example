# Production frontend values for Cloudflare Pages.
# These values are safe to expose in the browser build.
VITE_AUTH_MODE=supabase
VITE_API_URL=https://api.memexai.xyz
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production backend values for the API runtime.
# Store these as platform secrets, not in Cloudflare Pages public variables.
SEARCHTUBE_STORAGE=supabase
SEARCHTUBE_AUTH_MODE=supabase
SEARCHTUBE_API_KEY_MODE=hybrid
SEARCHTUBE_ALLOWED_ORIGINS=https://memexai.xyz,https://www.memexai.xyz,https://memexai.pages.dev
MEMEXAI_APP_URL=https://memexai.xyz

FREE_SEARCHES_PER_MONTH=100
FREE_INDEXED_VIDEOS_TOTAL=15
FREE_INDEXED_TRANSCRIPT_SECONDS_TOTAL=18000
FREE_MAX_IMPORT_VIDEOS=10
FREE_MAX_SEARCH_RESULTS=5
FREE_MAX_ACTIVE_INGESTION_JOBS=1

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLUS_MONTHLY_LOOKUP_KEY=memexai_plus_monthly_v1
STRIPE_PLUS_ANNUAL_LOOKUP_KEY=memexai_plus_annual_v1
STRIPE_PRO_MONTHLY_LOOKUP_KEY=memexai_pro_monthly_v1
STRIPE_PRO_ANNUAL_LOOKUP_KEY=memexai_pro_annual_v1
STRIPE_SUCCESS_URL=https://memexai.xyz/?billing=success
STRIPE_CANCEL_URL=https://memexai.xyz/?billing=cancelled
STRIPE_PORTAL_RETURN_URL=https://memexai.xyz/?settings=billing

INGESTION_DISPATCH_MODE=cloudflare_queue
INGESTION_QUEUE_PULL_BATCH_SIZE=1
INGESTION_QUEUE_VISIBILITY_TIMEOUT_MS=3600000
INGESTION_QUEUE_IDLE_SLEEP_SECONDS=5
INGESTION_QUEUE_ERROR_SLEEP_SECONDS=10
INGESTION_QUEUE_MAX_CONSECUTIVE_ERRORS=10
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_INGESTION_QUEUE_ID=your-cloudflare-queue-id
CLOUDFLARE_QUEUES_API_TOKEN=your-cloudflare-queues-token

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
API_KEY_ENCRYPTION_KEY=replace-with-a-long-random-secret

GEMINI_API_KEY=your-server-side-gemini-key
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini-3.1-flash-lite
WORKFLOW_INTERNAL_SECRET=replace-with-a-long-random-secret
